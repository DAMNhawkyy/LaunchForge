# Copy this file to ".env" and fill in your values. NEVER commit ".env" to git.
APP_ENV=development
PORT=8000

# Long random text used to sign login cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# SQLite (default) needs no setup. For PostgreSQL use e.g.
#   postgresql://launchforge:change_me@localhost:5432/launchforge
DATABASE_URL=sqlite:///./launchforge.db

# "mock" = built-in fake generator (no API key, no quota). "gemini" = real AI.
AI_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Generations allowed per user per hour (each real call costs quota)
GENERATE_LIMIT_PER_HOUR=10
